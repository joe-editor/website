---
permalink: "NEWS.html"
layout: "base.njk"

title: "Changelog"
---
<% let news = await git.read(versions.info[versions.latestUnix].git.unix, "NEWS.md") %>
<% let toc = [] %>
<div class="container">
  <div class="row">
    <div class="col-sm-8">
      <%- md(news, toc) %>
    </div>
    <nav class="col-sm-3 hidden-sm-down bg-faded sidebar">
      <ul class="nav nav-pills flex-column">
        <% toc.forEach(section => {
               if (section.level == 3) { %>
          <li class="nav-item">
            <a class="nav-link" href="#<%= section.anchor %>"><%= section.text %></a>
          </li>
        <% }}) %>
      </ul>
    </nav>
  </div>
</div>
