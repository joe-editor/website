---
permalink: "NEWS.html"
layout: "content.ejs"

title: "Changelog"
description: "Joe's Own Editor Changelog"
---
<% let news = await git.read("main", "NEWS.md") %>
<div class="container">
  <div class="row">
    <div class="col-sm-8">
      <%- md(news) %>
    </div>
    <nav class="col-sm-3 hidden-sm-down bg-faded sidebar">
      <ul class="nav nav-pills flex-column">
        <% utils.toc(news).forEach(section => {
               if (section.level == 3) { %>
          <li class="nav-item">
            <a class="nav-link" href="#<%= section.anchor %>"><%= section.text %></a>
          </li>
        <% }}) %>
      </ul>
    </nav>
  </div>
</div>
