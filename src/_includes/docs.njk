---
layout: "content.njk"
---
<div class="row">
  <div class="col-sm-8" id="md-contents">
    {{ content | stripTOC | safe }}
  </div>
  <div class="col-sm-4 offset-sm-8 sidebar hidden-xs-down h-100" style="position:fixed; overflow-x:hidden;">
    <div class="" id="md-toc">
    </div>
  </nav>
</div>

{% js "defer" %}
<script src="/js/tocbot.min.js"></script>
{% endjs %}

{% js %}
tocbot.init({
  tocSelector: '#md-toc',
  contentSelector: '#md-contents',
  headingSelector: 'h2, h3, h4',
  collapseDepth: 5,
  scrollContainer: 'body',
  scrollSmooth: true,
});

layoutbus.addEventListener("navResize", ev => {
  const height = ev.detail.height;
  tocbot.refresh({
    tocSelector: '#md-toc',
    contentSelector: '#md-contents',
    headingSelector: 'h2, h3, h4',
    collapseDepth: 5,
    scrollContainer: 'body',
    scrollSmooth: true,
    headingsOffset: height + 5,
    scrollSmoothOffset: -(height + 5),
  });
});
{% endjs %}

{% css "defer" %}
<link rel="stylesheet" href="/css/tocbot.css">
{% endcss %}
